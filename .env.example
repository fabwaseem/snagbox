# Server
# Local docker compose placeholder only. Not a credential.
POSTGRES_PASSWORD=xxxxxxxx
NODE_ENV=development
PORT=3001
# Milliseconds to keep accepting requests after SIGTERM so the proxy can detach.
# /api/health returns 503 during this window. Default 9000. Hard stop at 25s.
SHUTDOWN_DRAIN_MS=9000

# Database — PostgreSQL. Required; there is no fallback.
# Create the database first:  createdb -U postgres downloader
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/downloader?schema=public"

# CORS — comma separated list of allowed origins (exact origins or bare domains)
ALLOWED_ORIGINS=http://localhost:3000

# Security
# Shared secret proving a request came through the official frontend proxy.
# Must equal API_PROXY_SECRET in apps/web. Generate: openssl rand -hex 32
# In every environment, requests need this (via the frontend), a valid X-API-Key,
# or an explicit opt-out. NODE_ENV does not open the API.
FRONTEND_SECRET=
# Set to true to allow requests with no API key and no frontend secret.
# Leave unset (or false) everywhere you do not mean to run fully open.
AUTH_DISABLED=false
# HMAC secret for per-job file links. Empty uses BETTER_AUTH_SECRET, then a
# hash of DATABASE_URL. Set this when those values are shared with other apps.
FILE_LINK_SECRET=
# Redis for the job queue, per-key rate limits, the IP throttler and the media cache.
# Leave empty to use in-memory fallbacks (fine for a single local process).
REDIS_URL=
LOG_LEVEL=info
# Token for /v2/admin endpoints (key management, download history). Leave empty to disable admin routes.
ADMIN_TOKEN=
# Swagger UI at /docs. On unless set to false. The OpenAPI document is always at /openapi.json.
SWAGGER_ENABLED=true
# Accept any public http(s) URL, not only the built-in platforms. SSRF checks still apply.
ALLOW_GENERIC_URLS=false
# HMAC secret for job completion webhooks. Empty uses FILE_LINK_SECRET.
WEBHOOK_SECRET=

# Authentication (Better Auth) ---------------------------------------------
# Signing secret for sessions. Required in production, and required by
# `docker compose up`: compose sets NODE_ENV=production and stops immediately
# if this is empty. Generate: openssl rand -base64 32
# For local testing, set AUTH_DISABLED=true (Compose also sets it on the API).
BETTER_AUTH_SECRET=
# Public origin of the frontend (OAuth callbacks are <this>/api/auth/callback/<provider>)
BETTER_AUTH_URL=http://localhost:3000
# Social login — a provider is enabled only when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# SMTP for email OTP / verification mail. Unset = codes are logged to the API console (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Snagbox <no-reply@example.com>"

# Rate limiting (requests per window, per client IP)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=60

# Engine
MAX_CONCURRENT_JOBS=3
# Duration caps: guests get MAX_DURATION_SECONDS, signed-in users get
# AUTH_MAX_DURATION_SECONDS (4h default), API keys use their per-key limit.
MAX_DURATION_SECONDS=3600
AUTH_MAX_DURATION_SECONDS=14400
# How long a finished file stays downloadable. 4320 = 3 days.
FILE_TTL_MINUTES=4320

# Storage --------------------------------------------------------------------
# "local" keeps finished files on the container's disk — fine for development,
# but the disk is ephemeral, so every redeploy voids links already handed out.
# "r2" offloads them to Cloudflare R2 and serves them by presigned URL, so the
# bytes go straight from storage to the browser (no API/proxy bandwidth) and
# HTTP range requests — i.e. resuming an interrupted download — work natively.
# Any S3-compatible bucket works via R2_ENDPOINT.
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=downloads
# Overrides the derived https://<account>.r2.cloudflarestorage.com endpoint
# (set this to use S3, MinIO, Backblaze B2, etc. instead).
R2_ENDPOINT=
# Lifetime of a download link. Long enough to survive a paused-and-resumed
# download, short enough that a leaked URL stops working. 21600 = 6 hours.
SIGNED_URL_TTL_SECONDS=21600
# Hard ceiling on bytes held in the bucket. Retention bounds how long a file
# lives but not how many arrive, so this is what actually keeps storage inside
# a free allowance: once reached, the oldest finished downloads are evicted to
# make room. Default 8 GiB, safely under R2's 10 GB free tier.
STORAGE_QUOTA_BYTES=8589934592
# Media-info cache TTL (0 disables). Repeated pastes of the same URL skip yt-dlp.
MEDIA_CACHE_TTL_SECONDS=300
# Optional absolute paths; default to ./downloads and ./bin inside the app
DOWNLOADS_DIR=
BIN_DIR=

# yt-dlp resolution & workarounds ------------------------------------------
# The engine auto-resolves yt-dlp: YTDLP_PATH > system PATH > managed download
# > python module > zipimport fallback. Every candidate is verified by running
# --version, so it works on glibc, musl (with python3), and slim images alike.
# Explicit binary overrides (skip auto-detection):
YTDLP_PATH=
# Pinned yt-dlp release (YYYY.MM.DD) downloaded when no binary is installed.
# Empty uses the version pinned in the server (2026.08.19).
YTDLP_VERSION=
# Provider direct downloads (TikTok embed fallback and similar).
DIRECT_DOWNLOAD_TIMEOUT_MS=300000
DIRECT_DOWNLOAD_MAX_BYTES=2147483648
FFMPEG_PATH=
# JavaScript runtime for YouTube's "n" challenge. REQUIRED for YouTube: without
# it YouTube returns storyboards only and yt-dlp reports "Sign in to confirm
# you're not a bot" — which looks like an IP block but is not one. yt-dlp only
# enables deno by default, so we opt Node in explicitly.
# Empty = auto (deno on PATH, else the Node running this API — needs Node 22+).
# Set to a spec like "deno", "node:/usr/bin/node", or "none" to disable.
# Verify with GET /health → engine.jsRuntime
YTDLP_JS_RUNTIME=
# Netscape cookies.txt — for age-gated / members-only content, and as a fallback
# if a datacenter IP is genuinely flagged. Either a file path, or base64 of the
# file's content for hosts without persistent storage:  base64 -w0 cookies.txt
# COOKIES_B64 is only a SEED. YouTube rotates session cookies on use and yt-dlp
# writes the refreshed jar back; with STORAGE_DRIVER=r2 that refreshed jar is
# persisted to the bucket (internal/cookies.txt) and restored on boot, so the
# session rolls forward instead of decaying back to this fixed snapshot every
# redeploy. Use a throwaway Google account, never a real one.
COOKIES_FILE=
COOKIES_B64=
# Route yt-dlp traffic through a proxy (residential proxies defeat IP blocks)
YTDLP_PROXY=
# Extra args appended to every yt-dlp call, whitespace-separated.
# e.g. --extractor-args youtube:player_client=web_safari
YTDLP_EXTRA_ARGS=
# Some datacenter IPv6 ranges are blocked by platforms; force IPv4 if downloads stall.
YTDLP_FORCE_IPV4=false
# Self-update yt-dlp daily at 04:00 (extractor breakage is the #1 failure cause).
# Proof-of-origin token provider (bgutil). YouTube refuses some videos to
# clients that cannot present a PO token and enforces it hardest against server
# IP ranges, where no player client gets through. Run the provider alongside
# the API and point this at it, e.g. http://bgutil.railway.internal:4416
# (image: brainicism/bgutil-ytdlp-pot-provider, port 4416). The yt-dlp plugin
# itself ships inside the API image. Empty disables the integration.
YTDLP_POT_BASE_URL=
YTDLP_AUTO_UPDATE=true
# Parallel fragment downloads (1-16). Higher = faster HLS/DASH downloads.
YTDLP_CONCURRENT_FRAGMENTS=4
# yt-dlp tries per extraction and per download, including the first (1-5).
# Kept low on purpose: when a platform refuses to serve its watch page, the
# recovery path is the alternate extractors (e.g. TikTok's embed endpoint),
# not more attempts. Set to 1 to disable retrying entirely.
YTDLP_MAX_ATTEMPTS=2
# Base for the exponential backoff between those attempts, in milliseconds.
YTDLP_RETRY_BASE_MS=800
