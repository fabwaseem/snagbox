{
  "name": "snagbox",
  "version": "2.0.0",
  "private": true,
  "description": "Paste a link, snag the media: a self-hostable downloader API.",
  "license": "MIT",
  "homepage": "https://github.com/fabwaseem/snagbox#readme",
  "bugs": {
    "url": "https://github.com/fabwaseem/snagbox/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabwaseem/snagbox.git"
  },
  "scripts": {
    "build": "pnpm --filter @snagbox/shared build && prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "exec node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "pnpm --filter @snagbox/shared build && prisma generate && tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "pretest": "pnpm --filter @snagbox/shared build && prisma generate",
    "test": "jest --forceExit && jest --config ./test/jest-e2e.json --forceExit",
    "test:e2e": "jest --config ./test/jest-e2e.json --forceExit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/lib-storage": "^3.1103.0",
    "@aws-sdk/s3-request-presigner": "^3.1103.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@snagbox/shared": "file:./packages/shared",
    "better-auth": "^1.6.25",
    "bullmq": "^6.3.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "extract-zip": "^2.0.1",
    "follow-redirects": "^1.16.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^9.0.4",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.0",
    "@types/follow-redirects": "^1.14.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
